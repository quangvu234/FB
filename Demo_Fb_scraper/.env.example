# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env.

# LLM cho lệnh agent: openai | groq | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=your_groq_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Hồ sơ Chrome riêng cho automation (xem README)
USE_SYSTEM_CHROME=0
USE_LOCAL_BROWSER=1
CHROME_USER_DATA_DIR=fb_profile
CHROME_PROFILE_DIRECTORY=Default
BROWSER_CDP_URL=http://127.0.0.1:9223
# CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
